# Исключаем из build-контекста тяжёлое и лишнее.
#
# Про синтаксис: в .dockerignore `*` НЕ проходит через `/`. Правило `*.zip`
# ловит архивы только в корне; для любой глубины нужно `**/*.zip`.
.git/
.venv/
venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# Локальный .env с ХОСТОВЫМ путём — в контейнере путь другой (см. docker-compose).
.env

# Модели: в контекст берём ТОЛЬКО боевую person_ruBERT. Старые копии
# (_baseline, _old, _distilled) и архивы — это ~450 МБ, которые иначе
# отправлялись бы в контекст при каждой сборке.
models/*
!models/person_ruBERT

# Архивы в любом месте дерева.
**/*.zip
**/*.tar.gz

# GramLynx — отдельный сервис, в образ анонимизации не нужен (гигабайты моделей).
tests/GramLynx/

# Служебное — к сборке отношения не имеет.
.claude/

# Кэши
.pytest_cache/
.ruff_cache/
.mypy_cache/
