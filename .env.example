# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env

# ── Интеграция с Chatwoot ────────────────────────────────
# По умолчанию сервис работает standalone (без БД, без /anonymize/conversation,
# /anonymize/batch, /webhook). Чтобы включить интеграцию — раскомментируйте
# и заполните CHATWOOT_ENABLED + DATABASE_URL (+ POSTGRES_* для docker-compose)
# и опционально CHATWOOT_WEBHOOK_SECRET.
# CHATWOOT_ENABLED=true

# ── PostgreSQL (нужен ТОЛЬКО при CHATWOOT_ENABLED=true) ──
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=conversations_db

# ── Сервис анонимизации ──────────────────────────────────
# Обязателен, только если CHATWOOT_ENABLED=true. Пусто = БД не сконфигурирована,
# сервис работает standalone (при попытке включить интеграцию без DATABASE_URL —
# ошибка при старте).
DATABASE_URL=postgresql://user:changeme@db:5432/conversations_db

# API-ключ для защиты эндпоинтов /anonymize/*
# Оставьте пустым чтобы отключить аутентификацию (только для разработки)
API_KEY=

# Секрет для верификации подписи Chatwoot webhook (нужен ТОЛЬКО при CHATWOOT_ENABLED=true)
# Берётся из Chatwoot: Settings -> Integrations -> Webhooks -> Secret Token
# Оставьте пустым чтобы отключить проверку подписи
CHATWOOT_WEBHOOK_SECRET=

# ── Модель распознавания ФИО (PERSON) ────────────────────
# ОБЯЗАТЕЛЬНА. Путь к дообученной ruBERT-модели (папка с config.json).
# Запасного распознавателя нет: если модель не задана, ФИО не будут найдены
# вообще, поэтому сервис откажется стартовать. Загрузить: scripts/fetch_person_model.sh
# Требует установленных transformers и torch в окружении.
# В Docker путь указывать внутри контейнера (например /app/models/person_ruBERT).
PERSON_MODEL_DIR=

# Необязательно: метка модели ФИО для /health и снимков замеров (benchmarks/).
# Пусто = берётся имя папки из PERSON_MODEL_DIR. Задавать стоит, когда папка
# называется невыразительно: цифры качества зависят от модели не меньше, чем от
# кода, и по номеру версии её не опознать. Путь наружу не отдаётся, только имя.
PERSON_MODEL_NAME=

# Аварийный флаг: разрешить старт БЕЗ модели PERSON.
# ТОЛЬКО для тестов и CI, где модели нет в чекауте. В проде НЕ включать —
# ФИО будут уходить в ответ в открытом виде. Проверить можно по /health:
# person_model_loaded=false и status=degraded.
ALLOW_NO_PERSON_MODEL=false
